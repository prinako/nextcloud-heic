# Generate a separate password for each field, for example with openssl rand -hex 32.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

NEXTCLOUD_TRUSTED_DOMAINS=localhost
NEXTCLOUD_PORT=8080
# NEXTCLOUD_IMAGE=ghcr.io/prinako/nextcloud-heic:dev
# TZ=UTC

# For a reverse proxy or tunnel, add the public hostname to NEXTCLOUD_TRUSTED_DOMAINS.
# TRUSTED_PROXIES=
# OVERWRITEPROTOCOL=https

# Traefik overlay
# NEXTCLOUD_DOMAIN=cloud.example.com
# TRAEFIK_NETWORK=traefik-net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=

# Optional profiles
# CLOUDFLARE_TUNNEL_TOKEN=
# NOTIFY_PUSH_ARCH=x86_64
# ONLYOFFICE_JWT_SECRET=
# ONLYOFFICE_PORT=8081
